@article{ChuDeYinJianShuiZhengCeYouXiaoXingYuQiYeYuQiGaiShan2026,
  type = {10.19744/j.cnki.11-1235/f.2026.0136},
  title = {减税政策有效性与企业预期改善},
  author = {储德银 and 纪宇轩 and 刘俸奇},
  date = {2026},
  journaltitle = {管理世界},
  volume = {42},
  number = {10},
  pages = {109--125},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0136},
  abstract = {伴随我国大规模减税降费政策由以普惠性减税为主转向普惠性减税与结构性减税并举的组合式税费政策，如何通过减税政策有效改善企业预期与提振市场信心，不仅有助于提升宏观经济治理效能，亦能推动“稳增长”与“稳就业”目标实现。本文以增值税留抵退税改革作为减税政策典型代表，通过“相对成本效应”、“风险承担效应”与“资源配置效应”系统诠释其对企业预期改善的作用机制，深入考察了留抵退税改革对企业预期变化的影响效应。研究发现：留抵退税能够显著改善企业预期，且该结论经稳健性检验后依然成立。机制分析表明，留抵退税主要通过降低交易成本、提高成本粘性以及促进风险承担实现企业预期的显著改善，而增值税抵扣链条不完善是导致“资源配置效应”无法实现的根本原因。异质性检验结果显示，在融资约束较高、税负较重、规模较小、成长能力较弱的情形下，留抵退税的激励作用更为明显。拓展性分析发现，留抵退税通过企业预期改善对“稳增长”和“稳就业”存在显著的涟漪效应，较高的企业预期作为“中介放大器”在长期发挥了明显的正向调节作用。本文研究不仅能为“稳预期、强信心”提供新的研究思路，还能通过健全预期管理机制为促进经济高质量发展提供理论依据。},
  isbn = {1002-5502},
  keywords = {减税政策;增值税留抵退税;企业预期改善;涟漪效应}
}

