@article{LiPengQuanQiuZiMaoXieDingWangLuoYuMaoYiYinHanTanFuLiJiYuWangLuoGuanLianJieGouDeShiJiao2026,
  type = {10.19744/j.cnki.11-1235/f.2026.0138},
  title = {全球自贸协定网络与贸易隐含碳福利——基于网络关联结构的视角},
  author = {李鹏 and 史丹},
  date = {2026},
  journaltitle = {管理世界},
  volume = {42},
  number = {10},
  pages = {25--45},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0138},
  abstract = {在全球自贸协定网络快速扩张背景下，其关联结构如何影响国际贸易中的碳排放跨境转移与福利分配，成为协调贸易自由化与气候治理的关键问题。本文构建了一个纳入全球自贸协定网络关联特征的多国多部门一般均衡模型，系统刻画了自贸协定网络对贸易隐含碳福利的影响及其作用机理。本文基于世界贸易组织“深层协定”数据库和经济合作与发展组织多区域行业数据集，通过构造全球自贸协定网络相关指标，对理论分析进行了检验。研究发现，网络邻近性指数提升和处于同一社团显著促进贸易隐含碳福利改善，网络路径距离缩短会促进贸易隐含碳福利提升。自贸协定网络对贸易隐含碳福利的影响因不同行业、技术水平、协定类型、社团归属结构而表现出较大差异。出口规模、碳排放强度以及价值链技术溢出是自贸协定网络影响贸易隐含碳福利的重要渠道。中国情境下，整体网络在网络邻近性维度效应更强，环境条款网络在社团内部协调维度传导效应强于深度条款口径。反事实模拟显示，在欧美加征碳关税背景下，中国加入《全面与进步跨太平洋伙伴关系协定》或推动在谈协定落地的碳福利变化在不同国家间表现出显著异质性。本文认为，全球自贸协定网络为贸易自由化与气候治理提供了协同路径，仍须强化产业技术合作、优化网络布局，以应对碳关税可能引发的国际冲突。},
  isbn = {1002-5502},
  keywords = {自贸协定网络;贸易隐含碳福利;多国多部门一般均衡模型;网络关联结构}
}

