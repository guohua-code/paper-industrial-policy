@article{XuShuLaoDongLiChengBenChongJiDeZiYuanPeiZhiXiaoYingYanJiuJiYuChanPinYuYaoSuShiChangDeShuangChongShiJiao2026,
  type = {10.19744/j.cnki.11-1235/f.2026.0143},
  title = {劳动力成本冲击的资源配置效应研究——基于产品与要素市场的双重视角},
  author = {徐舒 and 孙可可 and 魏文博 and 吴明琴},
  date = {2026},
  journaltitle = {管理世界},
  volume = {42},
  number = {10},
  pages = {88--109},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0143},
  abstract = {平衡劳动力成本上涨对中国经济发展的二元影响，是推动经济高质量发展的关键。劳动力成本上涨既意味着劳动者收入的增长和就业质量的提升，也可能造成企业经营成本的上升和潜在产出的损失。本文阐述了劳动力成本上涨内生推动要素配置效率改善、提升全要素生产率的新机制及其实现条件，为应对劳动力成本上涨的影响提供了新的理论解释和现实依据。文章构建了一个劳动力要素市场和产品市场联动的一般均衡模型，表明企业受到的差异化劳动力成本冲击与其产品市场需求的异质性相互作用，会使劳动力和产品市场份额都向高工资和大规模的企业转移。这一机制改善了劳动力要素的配置效率并提升了宏观全要素生产率水平。将最低工资上涨作为劳动力成本冲击的测度，本文的测算结果表明，样本区间内劳动力成本上涨经由上述机制引致的劳动力再配置能解释总体全要素生产率增长的4\%～8\%，其中，企业异质性劳动成本冲击渠道解释了整体效应的60\%，企业在产品市场上的异质性需求弹性和价格传导率解释了剩余的40\%。本文研究表明，畅通劳动要素流动、提升产品市场有序竞争是平衡劳动力成本上涨的二元影响、实现高质量发展的有效手段。},
  isbn = {1002-5502},
  keywords = {核心,劳动力成本;价格传导;要素配置效率;结构估计}
}

@article{ZhangLiWeiRaoDianShangPingTaiDeChanYeLianXianShangJiaQiangXianXiaJiJuDeZhengJu2026,
  type = {10.19744/j.cnki.11-1235/f.2026.0135},
  title = {围绕电商平台的产业链：线上加强线下集聚的证据},
  author = {张莉 and 高涵 and 陈强远},
  date = {2026},
  journaltitle = {管理世界},
  volume = {42},
  number = {10},
  pages = {70--88},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0135},
  abstract = {地理距离在数字经济时代是否依然重要？本文以全球领先的跨境电商平台希音为例，通过深入的实地调研，并结合全国工商企业注册数据、广东省纺织服装行业汇算清缴数据以及企业业务工序文本等微观大数据，考察了链主型平台入驻对周边产业链集聚与韧性的影响。研究发现：希音的入驻显著加强了纺织服装企业在地理空间上的集聚，并呈现出随距离增加而衰减的特征，证明了数字时代地理邻近性在支撑“小单快反”模式中的重要性。在外部贸易冲击下，链主型平台通过强化产业链垂直分工、促进知识溢出及增强市场波动抵御能力，显著提升了周边企业的经营绩效与产业链韧性。这一集聚效应并非源于简单的选址自选择或工厂随迁，而是平台通过数字化管理与协同效应实现的产业链赋能。本文的研究不仅在理论上回应了数字时代“地理终结”的争议，揭示了“线上需求驱动线下集聚”的空间经济规律，也为传统产业集群在国际环境波动中借助平台力量实现数字化转型、构建高韧性供应链提供了实践启示。},
  isbn = {1002-5502},
  keywords = {独角兽企业;希音;集聚效应;跨境电商平台;链主企业}
}

@article{ZhangYiHouFaGuoJiaChanYeHeXinJiShuZhuiGanDeChanXueYanHeZuoChuangXinJiZhiJiYuZhongGuoGaoTieChanYeDeAnLiFenXi2024,
  type = {10.19744/j.cnki.11-1235/f.2024.0118},
  title = {后发国家产业核心技术追赶的产学研合作创新机制——基于中国高铁产业的案例分析},
  author = {张艺 and 陈凯华 and 周志勇},
  date = {2024},
  journaltitle = {管理世界},
  volume = {40},
  number = {11},
  pages = {20--48},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2024.0118},
  abstract = {后发国家如何构建起有效的产学研合作机制来支撑产业核心技术追赶？中国高铁产业成功案例很好地回答了这个理论议题。本文基于该案例，从创新链视角去探讨产学研合作和后发国家产业技术追赶之间的联动关系。研究发现：（1）产学研创新主体在政府政策和市场用户需求拉动的共同影响下，形成了支撑后发产业部门培育发展产业核心技术能力的本土创新共同体，它们成为了后发国家开展核心技术追赶和突破的核心力量；（2）产学研创新主体在“逆向反求”和“正向设计”的驱动机制作用下，在创新链上游的科学理论研究、中游的共性技术开发和下游的产品技术商业化等环节形成一个相互促进、相互反馈的产学研协同创新机制，成为了后发国家培育本土技术创新能力和实现技术追赶的重要组织模式和制度安排；（3）以产业界为核心的“知识利用系统”和以学术界为核心的“知识创造系统”之间耦合互动，推动科学、技术和产品知识在学术界和产业界之间双向流动，有助于产业核心技术能力不断升级跃迁，由生产性专用技术能力发展到应用性平台技术能力，再发展到基础性前沿技术能力来支撑技术追赶。本研究为后发国家如何通过产学研合作来协助产业部门实现核心技术追赶具有重要实践启示意义。},
  isbn = {1002-5502},
  keywords = {后发国家;技术追赶;产业技术能力;产学研合作;中国高铁产业}
}

@article{ZhaoXiaoLeiDianDongQiCheHuanJingXiaoYiYuCiYouBuTieSheJiJiYuWuRanKuaQuYuZhuanYiDeShiJiao2026,
