@article{LiYangShuangLianRongHeShiYuXiaZhongGuoNongYeXianDaiHuaFaZhanMoShiYanJiu2026,
  type = {10.19744/j.cnki.11-1235/f.2026.0145},
  title = {双链融合视域下中国农业现代化发展模式研究},
  author = {李阳 and 冯利伟 and 刘军 and 薛刘洋 and 卢一斌},
  date = {2026},
  journaltitle = {管理世界},
  volume = {42},
  number = {10},
  pages = {1--25},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0145},
  abstract = {面对农业现代化发展进程中科技创新成果与农业产业需求脱节的现实难题，寿光市以蔬菜产业为载体探索农业产业链与创新链融合发展道路，形成了极具代表性的农业现代化发展模式，这为学界探讨中国农业现代化发展模式背后的理论意蕴提供了典型案例。基于此，本文以寿光蔬菜产业为研究对象，从双链融合视角探讨了其农业现代化发展模式的特征、机制与底层逻辑等内容。研究发现：（1）在农业现代化发展进程中，农业产业链与创新链从“自然两分”状态融合演变为“复合链”，呈现出从“要素异质性”与“行为过程异步性”向“一致性融合”转变的关键特征；（2）基于双链融合的农业现代化发展模式表现为目标分层对齐（跨端）、业务一体化拓展（跨域）、组织多要素协同创新（跨层）和价值共创共享（跨界）等组件“四维一体”的复合式协同；进一步地，可以提炼出“耦合”“衍生”“重构”与“辐射”4种机制；（3）农业现代化发展模式的底层逻辑可以概括为新质生产力水平提升、新型生产关系变革的辩证统一，以及二者对产业价值创造与共享的协同影响，即以技术创新驱动农业新质生产力水平提升，进而推动生产关系适应性变革，最终实现价值多维度获取与外部溢出。本文最终形成的理论框架，既揭示了“寿光模式”中农业现代化发展的理论机制，又为其他地区探索农业现代化发展道路、推动产业端实践智慧与创新端理论智慧双向桥接提供了借鉴。},
  isbn = {1002-5502},
  keywords = {产业链;创新链;双链融合;农业现代化;寿光模式,排除}
}

