  pages = {45-69+190+70},
  url = {https://link.cnki.net/doi/10.19744/j.cnki.11-1235/f.2026.0146},
  abstract = {依托大规模基础设施的物理连通，环境负外部性在不完全市场中极易发生隐蔽的空间转移，引发区域间的博弈与政策失灵。本文以中国交通电动化为自然实验场景，深入探讨了电动汽车推广背后的空间外部性与次优环境政策设计问题。为此，本文整合了中国电厂运行数据与宏观电网结构，构建了“微观排放响应—宏观物理聚合”的边际排放因子模型，系统测算了电动汽车引致的本地环境收益与转出损害，并构建了内生化空间外部性的理论分析框架以设计次优补贴方案。本文有以下研究发现。（1）电动汽车引致的空间外部性的非对称冲击扭曲了社会边际成本。在高度依赖外受电与化石能源的地区，电动汽车的转出损害远超本地减排收益及燃油汽车成本。（2）内部化空间外部性后，部分隐匿了真实排放代价的节点由局部正向补贴转为全局重税，而替全局承担减排代价的内陆区域则由惩罚性征税转为正向补贴。（3）现行政策导致了区域间的“搭便车”行为与激励错配。东部消费中心通过全国电网将环境成本转嫁至中西部，而大气环流引发的“回旋镖效应”又使这部分成本部分回流，进一步加剧了环境福利不平等。本文为构建跨区域环境责任共担机制与次优环境税制提供了科学依据与政策启示。},
  isbn = {1002-5502},
  keywords = {电动汽车;空间外部性;激励错配;次优补贴;污染跨区域转移}
}

